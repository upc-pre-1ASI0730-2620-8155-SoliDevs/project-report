@startuml VitalSignsCapture
title Class Diagram - Bounded Context: Vital Signs Capture
skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty methods

package "API Layer" {
  class VitalSignsController <<API Routes>> {
    +GetDevices() : DeviceDto[]
    +CreateDevice(command: CreateDeviceCommand) : DeviceDto
    +UpdateDevice(id: string, command: UpdateDeviceCommand) : DeviceDto
    +DeleteDevice(id: string) : void
    +UpdateEpisodeVitals(episodeId: string, episode: EpisodeVitals) : void
  }
}

package "Application Layer" {
  interface IVitalSignsService <<interface>> {
    +ConfirmReadings(episode) : void
    +ReleaseEpisodeDevices(episodeId: string) : void
  }
  class VitalSignsService {
    +ReadFromDevice(episode, device) : void
    +SetManual(episode, key, value) : void
    +ClearVital(episode, key) : void
    +ConfirmReadings(episode) : void
    +RejectReadings(episode) : void
    +ReleaseEpisodeDevices(episodeId: string) : void
  }
}

package "Domain Layer" {
  class VitalSignEntry <<Value Object>> {
    -Key : VitalKey <<enum>>
    -Value : string
    -Source : ReadingSource <<enum>>
    -Model : string?
    -Time : string
  }
  class EpisodeVitals <<Aggregate Root>> {
    -EpisodeId : string
    -Confirmed : bool
    -VitalsConfirmedAt : DateTime?
    +ReadFromDevice(key, device) : void
    +SetManual(key, value) : void
    +Clear(key) : void
    +Confirm() : void
    +Reject() : void
  }
  class Device {
    -Id : int
    -Type : DeviceType <<enum>>
    -Model : string
    -Online : bool
    -LastUse : string?
    -LinkedEpisode : string?
  }
  enum ReadingSource {
    Auto
    Manual
  }

  enum VitalKey {
    Pa
    SpO2
    Fc
    Temp
  }
  enum DeviceType {
    BloodPressureMonitor
    PulseOximeter
    HeartRateMonitor
    Thermometer
  }
  class VitalsConfirmedEvent <<Domain Event>> {
    +EpisodeId : int
    +ReadingId : int
    +OccurredAt : DateTime
  }
}

package "Infrastructure Layer" {
  interface IVitalSignsRepository <<interface>> {
    +UpdateEpisodeVitalsAsync(episodeId: string, episode: EpisodeVitals) : Task<void>
    +GetDevicesAsync() : Task<IEnumerable<Device>>
    +AddDeviceAsync(device: Device) : Task<void>
    +UpdateDeviceAsync(device: Device) : Task<void>
    +DeleteDeviceAsync(id: int) : Task<void>
  }
  class VitalSignsRepository {
    -_context : AppDbContext
  }
}

VitalSignsController --> IVitalSignsService
VitalSignsService ..|> IVitalSignsService
VitalSignsService --> EpisodeVitals
VitalSignsService --> Device
VitalSignsService --> IVitalSignsRepository
EpisodeVitals --> VitalSignEntry
VitalSignEntry --> ReadingSource
VitalSignEntry --> VitalKey
Device --> DeviceType
EpisodeVitals ..> VitalsConfirmedEvent
@enduml
