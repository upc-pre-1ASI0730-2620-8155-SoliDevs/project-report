@startuml Alerting
title Class Diagram - Bounded Context: Alerting
skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty methods

package "API Layer" {
  class AlertsController <<Controller>> {
    +GetActiveAsync() : Task<ActionResult<IEnumerable<AlertDto>>>
    +AcknowledgeAsync(alertId: int, userId: int) : Task<IActionResult>
    +EscalateAsync(alertId: int, command: EscalationCommand) : Task<ActionResult<EscalationResponse>>
  }
  class AlertsHub <<UI Component>> {
    +JoinTriageGroup() : Task
    +JoinPatientGroup(episodeId: int) : Task
  }
}

package "Application Layer" {
  interface IAlertingService <<interface>> {
    +EvaluateVitalRangesAsync(readingId: int) : Task<Result<Alert?>>
    +AcknowledgeAsync(alertId: int, userId: int) : Task<Result<bool>>
    +ResolveIfSafeAsync(alertId: int) : Task<Result<bool>>
    +EscalateAsync(alertId: int, command: EscalationCommand) : Task<Result<EscalationResponse>>
  }
  class AlertingService {
    -_criticalLevel : TriageLevel = TriageLevel.I_Resuscitation
    +EvaluateVitalRangesAsync(readingId: int) : Task<Result<Alert?>>
    +AcknowledgeAsync(alertId: int, userId: int) : Task<Result<bool>>
  }
  interface IAlertBroadcaster <<interface>> {
    +BroadcastAlertAsync(alert: Alert) : Task
    +BroadcastResolutionAsync(alert: Alert) : Task
  }
  class InMemoryEventBus <<Event Bus>> {
    -_hubContext : IHubContext<AlertsHub>
  }
}

package "Domain Layer" {
  class Alert <<Aggregate Root>> {
    -Id : int
    -PatientName : string
    -Dni : string?
    -Episode : string
    -Priority : string
    -VitalSign : string
    -Value : string
    -SafeRange : string?
    -Severity : string
    -Time : string
    -CreatedAt : DateTime
    -AcknowledgedAt : DateTime?
    -EscalatedAt : DateTime?
    -EscalatedTo : string?
    +Acknowledge() : void
    +Escalate(to: string) : void
  }
  enum Severity {
    critical
    warning
    info
    resolved
    escalated
  }
}

package "Infrastructure Layer" {
  interface IAlertRepository <<interface>> {
    +GetActiveAsync() : Task<IEnumerable<Alert>>
    +AddAsync(alert: Alert) : Task<void>
    +UpdateAsync(alert: Alert) : Task<void>
  }
  class AlertRepository {
    -_context : AppDbContext
  }
}

AlertsController --> IAlertingService
AlertingService ..|> IAlertingService
AlertingService --> IAlertBroadcaster
InMemoryEventBus ..|> IAlertBroadcaster
AlertingService --> Alert
Alert --> Severity
AlertingService --> IAlertRepository
AlertingService ..> InMemoryEventBus
@enduml
