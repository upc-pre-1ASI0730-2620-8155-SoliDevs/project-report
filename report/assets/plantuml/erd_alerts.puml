@startuml
title Database Diagram - Bounded Context: Alerting
hide circle
skinparam linetype ortho

entity "alerts" as alerts {
  * id : INT <<PK>>
  --
  * patient_name : VARCHAR(120)
  dni : VARCHAR(12)
  * episode : VARCHAR(20) <<FK>>
  * priority : VARCHAR(20)
  * vital_sign : VARCHAR(12)
  * value : VARCHAR(20)
  safe_range : VARCHAR(30)
  * severity : VARCHAR(12)
  * time : VARCHAR(5)
  * created_at : DATETIME2
  acknowledged_at : DATETIME2
  escalated_at : DATETIME2
  escalated_to : VARCHAR(40)
}
entity "episodes" as episodes {
  * id : VARCHAR(20) <<PK>>
  --
  * patient_id : INT <<FK>>
}
alerts }o--|| episodes
@enduml
