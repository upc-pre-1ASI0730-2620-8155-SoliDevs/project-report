    {
      "id": "1V_Q07erFluOTlm86EVc8",
      "type": "text",
      "x": -276.17674808104823,
      "y": 113.41861979166669,
      "width": 602.4693100904726,
      "height": 247.63890121922327,
      "angle": 0,
      "autoResize": false,
      "backgroundColor": "transparent",
      "boundElements": [],
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 5,
      "fontSize": 15.239316998106048,
      "frameId": null,
      "groupIds": [],
      "index": "aT",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "The current state of emergency triage in hospitals and clinics has focused\nmainly on\ntriage staff capturing vital signs manually with standalone instruments and\npaper\nforms, causing slow registrations, transcription errors, imprecise prioritization\nand wrong-specialty referrals.\nWhat existing products fail to address is the end-to-end connection between\nmeasurement instruments and the triage workflow.\nOur product will address this gap with a responsive web platform that registers\npatients, captures vital signs automatically, classifies priority with staff\nvalidation, raises out-of-range alerts and routes patients to the right specialty.\nOur initial focus: triage personnel and patients in Lima emergency services.\nSuccess: faster triage, fewer errors, earlier detection of critical values.",
      "roughness": 1,
      "roundness": null,
      "seed": 815446512,
      "strokeColor": "#1e1e1e",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "The current state of emergency triage in hospitals and clinics has focused\nmainly on\ntriage staff capturing vital signs manually with standalone instruments and\npaper\nforms, causing slow registrations, transcription errors, imprecise prioritization\nand wrong-specialty referrals.\nWhat existing products fail to address is the end-to-end connection between\nmeasurement instruments and the triage workflow.\nOur product will address this gap with a responsive web platform that registers\npatients, captures vital signs automatically, classifies priority with staff\nvalidation, raises out-of-range alerts and routes patients to the right specialty.\nOur initial focus: triage personnel and patients in Lima emergency services.\nSuccess: faster triage, fewer errors, earlier detection of critical values.",
      "textAlign": "left",
      "updated": 1788018611728,
      "version": 1,
      "versionNonce": 1190796560,
      "verticalAlign": "top"
    },
