    {
      "id": "a8F7V3dGCwK9LeSv-03vm",
      "type": "text",
      "x": 394.84473629395177,
      "y": 457.8811848958333,
      "width": 527.7166160916083,
      "height": 311.474609375,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": [],
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 5,
      "fontSize": 14.657628676470598,
      "frameId": null,
      "groupIds": [],
      "index": "af",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "We believe we will achieve faster patient admissions if triage staff attain\ninstant registration with the digital patient registration feature.\n\nWe believe we will achieve fewer transcription errors if triage staff attain\nreliable readings with the automatic vital-signs capture feature.\n\nWe believe we will achieve more accurate triage if staff attain assisted\npriority classification (staff-validated) with the classification feature.\n\nWe believe we will achieve earlier escalation if staff attain immediate\nawareness of out-of-range values with the alerts feature.\n\nWe believe we will achieve fewer wrong-specialty referrals if staff attain\ndata-driven routing with the specialty assignment feature.\n\nWe believe we will achieve a growing user base if visitors attain clear\nunderstanding of digital triage value with the landing page.",
      "roughness": 1,
      "roundness": null,
      "seed": 1549881840,
      "strokeColor": "#1e1e1e",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "We believe we will achieve faster patient admissions if triage staff attain\ninstant registration with the digital patient registration feature.\n\nWe believe we will achieve fewer transcription errors if triage staff attain\nreliable readings with the automatic vital-signs capture feature.\n\nWe believe we will achieve more accurate triage if staff attain assisted\npriority classification (staff-validated) with the classification feature.\n\nWe believe we will achieve earlier escalation if staff attain immediate\nawareness of out-of-range values with the alerts feature.\n\nWe believe we will achieve fewer wrong-specialty referrals if staff attain\ndata-driven routing with the specialty assignment feature.\n\nWe believe we will achieve a growing user base if visitors attain clear\nunderstanding of digital triage value with the landing page.",
      "textAlign": "left",
      "updated": 1788018611729,
      "version": 1,
      "versionNonce": 310969616,
      "verticalAlign": "top"
    },
